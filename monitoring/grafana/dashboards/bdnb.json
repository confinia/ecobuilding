{
  "title": "EcoBuilding — Internal · BDNB local mirror",
  "uid": "ecobuilding-bdnb",
  "tags": ["internal"],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "bdnb-db up",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(pg_up{job=\"bdnb-db\"})", "instant": true }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "bdnb-rest up (dvf, vues)",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"bdnb-rest\"})", "instant": true }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "bdnb-open up (lookups)",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"bdnb-open\"})", "instant": true }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Base bdnb (taille)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "max(pg_database_size_bytes{datname=\"bdnb\"})", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Connexions actives",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(pg_stat_activity_count{datname=\"bdnb\"})", "instant": true }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connexions par état",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "sum by (state) (pg_stat_activity_count{datname=\"bdnb\"})", "legendFormat": "{{state}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Lignes lues (tuples returned/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "rate(pg_stat_database_tup_returned{datname=\"bdnb\"}[5m])", "legendFormat": "tuples/s" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pool PostgREST — connexions disponibles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "expr": "pgrst_db_pool_available{job=\"bdnb-rest\"}", "legendFormat": "bdnb-rest" },
        { "expr": "pgrst_db_pool_available{job=\"bdnb-open\"}", "legendFormat": "bdnb-open" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mémoire des conteneurs bdnb",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "expr": "podman_container_mem_usage_bytes * on (id) group_left(name) podman_container_info{name=~\".*bdnb.*\"}", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
