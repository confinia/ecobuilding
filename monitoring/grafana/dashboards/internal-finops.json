    {
      "id": 107,
      "type": "geomap",
      "title": "Où l'on regarde, et combien (bâtiments consultés)",
      "description": "Un point par bâtiment, portant son nombre de vues. L'infobulle donne l'adresse (cliquable), l'appareil, le système, le navigateur, la provenance du lien et le réseau tronqué. Aucune adresse IP, aucun identifiant de personne : le dernier octet du réseau est retiré (#356).",
      "datasource": {
        "type": "postgres",
        "uid": "vues"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  max(v.ts)                                          AS \"quand\",\n  coalesce(a.libelle_adr_principale_ban, v.bdnb_id)  AS \"adresse\",\n  count(*)::int                                      AS \"vues\",\n  mode() WITHIN GROUP (ORDER BY coalesce(v.type_appareil, 'inconnu')) AS \"appareil\",\n  mode() WITHIN GROUP (ORDER BY coalesce(v.systeme, 'inconnu'))       AS \"système\",\n  mode() WITHIN GROUP (ORDER BY coalesce(v.navigateur, 'inconnu'))    AS \"navigateur\",\n  mode() WITHIN GROUP (ORDER BY coalesce(v.source, 'direct'))         AS source,\n  mode() WITHIN GROUP (ORDER BY coalesce(v.reseau, 'inconnu'))        AS \"réseau\",\n  v.lat, v.lon,\n  'https://ecobuilding.confinia.io/?b=' || v.bdnb_id || '#18/'\n    || v.lat::text || '/' || v.lon::text || '/-30/60' AS url\nFROM vues.vue_batiment v\nLEFT JOIN bdnb_2026_02_a_open_data.batiment_groupe_adresse a\n       ON a.batiment_groupe_id = v.bdnb_id\nWHERE $__timeFilter(v.ts)\n  AND v.bdnb_id <> 'bdnb-bg-RPKN-5A8C-L5QV'\nGROUP BY v.lat, v.lon, v.bdnb_id, a.libelle_adr_principale_ban\nORDER BY count(*) DESC\nLIMIT 5000",
          "datasource": {
            "type": "postgres",
            "uid": "vues"
          }
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 46.6,
          "lon": 2.5,
          "zoom": 5
        },
