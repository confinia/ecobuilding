    {
      "id": 107,
      "type": "geomap",
      "title": "Où l'on regarde, et combien (bâtiments consultés)",
      "description": "Un point par bâtiment consulté. Aucune IP, aucun identifiant d'utilisateur : la coordonnée d'un bâtiment est publique, qui la regarde ne l'est pas (#349). Couleur = d'où vient la visite (référent d'atterrissage), jamais qui la fait.",
      "datasource": {
        "type": "postgres",
        "uid": "vues"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(ts) AS time, lat, lon, bdnb_id,\n       count(*)::int AS vues,\n       mode() WITHIN GROUP (ORDER BY coalesce(source, 'direct')) AS source,\n       -- Le lien est construit ICI, en pleine précision : un lien Grafana\n       -- interpole la valeur AFFICHÉE, donc arrondie, et le marqueur\n       -- tombait à un kilomètre du bâtiment, sur une route.\n       'https://ecobuilding.confinia.io/?b=' || bdnb_id || '#18/'\n         || lat::text || '/' || lon::text || '/-30/60' AS url\nFROM vues.vue_batiment\nWHERE $__timeFilter(ts)\n  AND bdnb_id <> 'bdnb-bg-RPKN-5A8C-L5QV'\nGROUP BY lat, lon, bdnb_id\nORDER BY vues DESC\nLIMIT 5000",
          "datasource": {
            "type": "postgres",
            "uid": "vues"
          }
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 46.6,
          "lon": 2.5,
          "zoom": 5
        },
        "basemap": {
          "type": "xyz",
          "name": "OpenStreetMap",
          "config": {
            "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            "attribution": "© OpenStreetMap"
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Vues",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "color": {
                  "field": "source",
                  "fixed": "orange"
                },
                "opacity": 0.75,
                "size": {
                  "field": "vues",
                  "fixed": 6,
                  "min": 6,
                  "max": 26
                },
                "text": {
                  "field": "vues",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": -1,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "tooltip": true
          }
        ],
        "controls": {
          "showZoom": true,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "legend": {
          "show": true,
          "displayMode": "list",
          "placement": "bottom"
        }
