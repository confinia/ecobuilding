    {
      "id": 108,
      "type": "table",
      "title": "Profils de visite (une ligne = un passage, personne n'est identifié)",
      "description": "Chaque ligne résume UNE visite : sa durée, combien de bâtiments, sur quel appareil, venue d'où. L'identifiant de visite naît en mémoire au chargement de la page et meurt avec l'onglet : deux passages d'une même personne ne peuvent pas être rapprochés (#356).",
      "datasource": {
        "type": "postgres",
        "uid": "vues"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  min(ts)                                   AS \"début\",\n  round(extract(epoch FROM max(ts) - min(ts)) / 60.0, 1) AS \"minutes\",\n  count(*)                                  AS \"bâtiments\",\n  count(DISTINCT round(lat::numeric, 2))    AS \"zones\",\n  max(systeme)                              AS \"système\",\n  max(navigateur)                           AS \"navigateur\",\n  max(coalesce(source, 'direct'))           AS \"provenance\",\n  max(pays)                                 AS \"pays\"\nFROM vues.vue_batiment\nWHERE $__timeFilter(ts) AND visite IS NOT NULL\nGROUP BY visite\nORDER BY min(ts) DESC\nLIMIT 200",
          "datasource": {
            "type": "postgres",
            "uid": "vues"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "direct": {
                  "color": "orange",
                  "index": 0
                },
                "linkedin": {
                  "color": "blue",
                  "index": 1
                },
                "teamopendata": {
                  "color": "purple",
                  "index": 2
                },
                "geocommuns": {
                  "color": "purple",
                  "index": 3
                },
                "reddit": {
                  "color": "red",
                  "index": 4
                },
                "data.gouv": {
                  "color": "green",
                  "index": 5
                },
                "google": {
                  "color": "yellow",
                  "index": 6
                },
                "whatsapp": {
                  "color": "light-green",
                  "index": 7
                },
                "email": {
                  "color": "light-blue",
                  "index": 8
                },
                "georezo": {
                  "color": "semi-dark-purple",
                  "index": 9
                },
                "autre": {
                  "color": "text",
                  "index": 10
                },
                "interne": {
                  "color": "text",
                  "index": 11
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "provenance"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
