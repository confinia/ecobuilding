{
  "title": "EcoBuilding — Internal · Identity & Keycloak",
  "uid": "ecobuilding-identity",
  "tags": ["internal"],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "User accounts",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(ecobuilding_kc_users)" }]
    },
    {
      "id": 2, "type": "stat", "title": "Organizations (existing)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "max(ecobuilding_kc_organizations)" }]
    },
    {
      "id": 3, "type": "stat", "title": "New users (30d)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "max(ecobuilding_kc_users) - min_over_time(max(ecobuilding_kc_users)[30d:1h])" }]
    },
    {
      "id": 4, "type": "stat", "title": "API keys created (total)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(ecobuilding_api_keys_total{event=\"created\"})" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Users over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "max(ecobuilding_kc_users)", "legendFormat": "users" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Organizations over time (created ↑ / removed ↓ = line moves)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "max(ecobuilding_kc_organizations)", "legendFormat": "organizations" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "New user accounts / day",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "expr": "increase(max(ecobuilding_kc_users)[1d:1h])", "legendFormat": "new users/day" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "API key creations / day",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "expr": "sum(increase(ecobuilding_api_keys_total{event=\"created\"}[1d]))", "legendFormat": "keys/day" }]
    }
  ]
}
