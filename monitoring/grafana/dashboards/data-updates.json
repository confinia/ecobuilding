      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Données — mises à jour\nFraîcheur des données **stockées** (snapshots) servies par EcoBuilding. Les sources **live** (Géorisques, PLU/GPU, adresses BAN, coûts DPE ADEME, Hub'Eau, PVGIS…) sont interrogées en temps réel et ne figurent pas ici. La date d'import DVF n'est pas encore suivie ([#401])."
      }
    },
    {
      "type": "stat",
      "title": "Bâtiments (BDNB) — âge du millésime (jours)",
      "datasource": {
        "type": "postgres",
        "uid": "vues"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 270
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT age_jours AS value FROM meta.data_updates WHERE source = 'Bâtiments (BDNB)'",
          "datasource": {
            "type": "postgres",
            "uid": "vues"
          }
        }
      ]
    },
