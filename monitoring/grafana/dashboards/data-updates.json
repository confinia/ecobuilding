      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source AS \"Source\", version AS \"Version / couverture\", publiee AS \"Dernière publiée\", retard AS \"Retard\", lignes AS \"Lignes\", as_of AS \"À jour au\", age_jours AS \"Âge (jours)\", verifie_le AS \"Vérifié le\" FROM meta.data_updates ORDER BY ord",
