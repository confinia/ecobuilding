# Stack-internal edge: single entry point of ONE blue/green stack.
# Hostname mapping is done upstream by the router (caddy_server/); here we
# only route paths to this stack's own services over the private network.
{
	admin off
	auto_https off
	servers {
		# Pass the original client IP through (router is a private-range peer).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	# Sondes de scanners (#327) : 404 sec AU BORD, avant le front. Le repli
	# SPA leur répondait 200 avec index.html — un scanner qui lit des 200
	# insiste. Rien de légitime ne ressemble à ces chemins : extensions de
	# technologies qu'on n'exécute pas, fichiers cachés, consoles d'admin
	# d'autres logiciels. /.well-known reste ouvert (security.txt, un jour).
	@sondes {
		path *.php *.asp *.aspx *.jsp *.axd *.action *.cgi *.bak *.backup
		path /.git/* /.env* /.aws/* /.ssh/* /.vscode/* /.docker* /.DS_Store
		path /wp-login* /wp-admin* /wp-content/* /xmlrpc.php /cgi-bin/*
		path /actuator/* /telescope/* /server-status /console /console/*
		path /debug/* /ecp/* /jsonrpc /graphql /graphql/* /@vite/*
		path /secrets.json /keys.json /config.json /config /settings
		path /login.action /mcp /mcp/* /__proxy_subdomain_* /telescope
	}
	handle @sondes {
		respond 404
	}

	# Public API (FastAPI). /api stripped; app root_path keeps docs correct.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Grafana a déménagé sur son propre nom (grafana.ecobuilding.confinia.io,
	# vhost plateforme) pour séparer ses identifiants de ceux de l'app. Les
	# anciens liens /grafana/... suivent, chemin conservé.
	handle_path /grafana* {
		redir https://grafana.ecobuilding.confinia.io{uri} permanent
	}

	# MapLibre frontend. no-cache = browsers must revalidate (ETag), so every
	# deploy reaches users without hard refresh; tiny files, cost negligible.
	handle {
		header Cache-Control "no-cache"
		reverse_proxy frontend:80
	}
}
