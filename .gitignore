__pycache__/
*.pyc
.venv/
node_modules/
deploy/secrets.env
data/
.DS_Store
sandbox_stack/secrets.env

# Generated on the VM from Caddyfile.$ACTIVE by stack-up/promote — never track.
caddy_server/Caddyfile
**/secrets.env
# e2e : identifiants et résultats de tests locaux, jamais suivis.
e2e/.env
e2e/.run/
e2e/results/
e2e/.npm-cache/

# Clé Creem test dans la config MCP locale — jamais suivie.
.mcp.json

# HAR de session dashboard (contient un jeton de session actif) — jamais suivi.
e2e/node_modules/
e2e/package.json
e2e/package-lock.json

# Projet Xcode généré par xcodegen (voir mobile/ios/README.md)
mobile/ios/EcoBuilding.xcodeproj/

mobile/ios/EcoBuilding/*.p8
# Le mobile vit dans son PROPRE dépôt privé (confinia/ecobuilding-mobile),
# cloné ici sous ./mobile. Le produit web est destiné à l'open source ; la
# partie commerciale ne doit pas s'y trouver, ni dans son historique.
mobile/

# Stratégie, prix, architecture de déploiement, feuille de route : dépôt privé
# confinia/ecobuilding-business, cloné ici sous ./business. Le code est ouvert,
# l'information d'affaires ne l'est pas. Les documents n'existent QUE là :
# aucune copie à la racine, qui finirait par diverger de la version versionnée.
business/

# Applications mobiles : dépôt confinia/ecobuilding-mobile, cloné sous ./mobile.
# Séparé pour son cycle de vie propre — compilations signées, magasins, versions
# installées qui survivent des mois à leur serveur.
mobile/

# Captures réseau de mise au point : volumineuses, et porteuses de jetons de
# session. Jamais versionnées.
**/*.har

# Captures HAR : cookies de session — jamais versionnées
*.har
