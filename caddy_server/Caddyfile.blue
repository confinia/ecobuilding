# ACTIVE = BLUE. prod -> blue stack (13100), staging -> green stack (13200).
# Installed as ./Caddyfile by deploy/promote.sh (or deploy.sh from .active).
{
	# 1PESI: 13090 = ecobuilding(3) · shared tier(0) · admin(9) · main.
	# UNIQUE per host-network caddy (a shared admin address let one caddy
	# load another's config and took the VM down on 2026-07-20).
	admin 127.0.0.1:13090
	auto_https off
	http_port 13000
	default_bind 127.0.0.1
	servers {
		# Keep the original client IP in X-Forwarded-For across the local
		# proxy chain (platform edge -> this router -> stack caddy -> api):
		# without this, each hop REPLACES XFF and the API only ever sees
		# loopback/bridge IPs (country metric = "unknown").
		trusted_proxies static private_ranges
	}
}

# Scanner probes (/.env, /.git, wordpress kits…): block with 403 AND log —
# monitored via: podman logs ecobuilding-edge_caddy_1 | grep '"status":403'
(block_scanners) {
	@scanners path /.env* *.env /.git* /.aws* /.ssh* /.svn* /.hg* /.DS_Store /.vscode* /.idea* /.npmrc /.docker* /wp-admin* /wp-login* /wp-content* /wp-includes* /xmlrpc.php *.php /vendor/* /credentials* /config.json /debug/* /actuator/* /*secret*
	respond @scanners 403
}

http://ecobuilding.confinia.io:13000 {
	log {
		output stdout
		format json
	}
	import block_scanners

	# Shared identity (ecobuilding-auth project): Keycloak under /auth,
	# stateful, outside blue/green like monitoring.
	handle /auth/* {
		reverse_proxy 127.0.0.1:13070
	}

	reverse_proxy 127.0.0.1:13100
}

http://staging.ecobuilding.confinia.io:13000,
http://staging.ecobuilding.confinia.io:13300 {
	log {
		output stdout
		format json
	}
	import block_scanners

	# Shared identity (ecobuilding-auth project): Keycloak under /auth,
	# stateful, outside blue/green like monitoring.
	handle /auth/* {
		reverse_proxy 127.0.0.1:13070
	}

	reverse_proxy 127.0.0.1:13200
}


# Dedicated API hosts (platform-agreed naming, environment leftmost). They
# reuse the SAME entry ports as their environment — a dedicated prod API port
# would force the platform edge to know which colour is active, i.e. put
# application logic upstream (platform RULES.md §1). The path is prefixed with
# /api so the stack caddy's existing handle_path strips it and reaches the API.
http://api.ecobuilding.confinia.io:13000 {
	log {
		output stdout
		format json
	}
	import block_scanners
	rewrite * /api{uri}
	reverse_proxy 127.0.0.1:13100
}

http://staging.api.ecobuilding.confinia.io:13000,
http://staging.api.ecobuilding.confinia.io:13300 {
	log {
		output stdout
		format json
	}
	import block_scanners
	rewrite * /api{uri}
	reverse_proxy 127.0.0.1:13200
}

:13000 {
	respond "ecobuilding router (active: blue)" 200
}

# 1PESI staging edge (platform request 2026-08-16): staging gets its own
# listener so the edge can tell prod and pre-prod apart. Dual-published
# with :13000 until the platform flips its block.
:13300 {
	respond "ecobuilding staging router (candidate: 13200)" 200
}
