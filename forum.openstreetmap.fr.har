            "text": ".voting-wrapper{display:flex;flex-direction:column;align-items:stretch;min-width:2.5em;margin-top:.1em}.voting-wrapper .fk-d-tooltip__trigger-container,.voting-wrapper .fk-d-tooltip__trigger,.voting-wrapper .topic-voting-menu-trigger{width:100%}.voting-wrapper .btn[disabled]:not(.is-loading){opacity:1;background:var(--primary-very-low);border:1px solid var(--content-border-color);width:100%}.voting-wrapper .btn[disabled]:not(.is-loading) span[aria-hidden=true]{display:none}.voting-wrapper .btn[disabled]:not(.is-loading) .d-icon{opacity:.5}.voting-wrapper__button{border-radius:var(--d-button-border-radius) var(--d-button-border-radius) 0 0;padding:var(--space-1) var(--space-3);background:var(--secondary);border:1px solid var(--content-border-color)}.voting-wrapper__button:focus-visible,.discourse-no-touch .voting-wrapper__button:hover{background:var(--primary-low)}.voting-wrapper__button:focus-visible .d-icon,.discourse-no-touch .voting-wrapper__button:hover .d-icon{color:var(--primary-high)}.voting-wrapper__button.btn-success .d-icon{color:var(--success)}.voting-wrapper__button.btn-success:focus-visible,.discourse-no-touch .voting-wrapper__button.btn-success:hover{background:var(--primary-low)}.voting-wrapper__button.btn-success:focus-visible .d-icon,.discourse-no-touch .voting-wrapper__button.btn-success:hover .d-icon{color:var(--success)}.voting-wrapper__count-text{color:var(--primary-high)}.voting-wrapper__count{border:1px solid var(--content-border-color);border-top:0;background:var(--secondary);border-radius:0 0 var(--d-button-border-radius) var(--d-button-border-radius);font-size:var(--font-down-2);padding:var(--space-half) var(--space-2);text-align:center}#topic-title:has(.voting),.nested-view__header:has(.voting){display:grid;grid-template-columns:auto 1fr;gap:0 var(--topic-body-width-padding)}#topic-title:has(.voting)>*,.nested-view__header:has(.voting)>*{grid-column:2}#topic-title:has(.voting) .voting,.nested-view__header:has(.voting) 