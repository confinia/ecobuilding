            "text": "const localeData = window._discourse_locale_data ??= {};\nlocaleData.messageFormatData = function (messageFormatModules) {\n  const { number, plural, select } = messageFormatModules[\"@messageformat/runtime\"];\n  const { en, fr } = messageFormatModules[\"@messageformat/runtime/lib/cardinals\"];\n  return {\n    fr: {\n      \"about.traffic_info_footer_MF\": (d) => \"Au cours des 6 derniers mois, ce site a diffusé du contenu à environ \" + plural(d.total_visitors, 0, fr, { one: number(\"fr\", d.total_visitors, 0) + \" personne\", other: number(\"fr\", d.total_visitors, 0) + \" personnes\" }) + \" chaque mois, avec environ \" + plural(d.eu_visitors, 0, fr, { one: number(\"fr\", d.eu_visitors, 0) + \" personne\", other: number(\"fr\", d.eu_visitors, 0) + \" personnes\" }) + \" de l'Union européenne.\\n\",\n      \"about.activities.visitors_MF\": (d) => plural(d.total_count, 0, fr, { one: d.total_formatted_number + \" visiteur\", other: d.total_formatted_number + \" visiteurs\" }) + \", environ \" + plural(d.eu_count, 0, fr, { one: d.eu_formatted_number, other: d.eu_formatted_number }) + \" de l'UE\\n\",\n      \"user.messages.read_more_group_pm_MF\": (d) => select(d.HAS_UNREAD_AND_NEW, { true: \"\\n    \" + plural(d.UNREAD, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" message non lu</a>\", other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" messages non lus</a>\" }) + \"\\n    \" + plural(d.NEW, 0, fr, { \"0\": \"\", one: \" et <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveau</a> message restant, ou parcourez les autres messages dans \" + d.groupLink, other: \" et <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveaux</a> messages restants, ou parcourez les autres messages dans \" + d.groupLink }) + \"\\n  \", false: \"\\n    \" + plural(d.UNREAD, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" message non lu</a>, ou parcourez les autres messages dans \" + d.groupLink, other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" messages non lus</a>, ou parcourez les autres messages dans \" + d.groupLink }) + \"\\n    \" + plural(d.NEW, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveau message</a>, ou parcourez les autres messages dans \" + d.groupLink, other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveaux messages</a>, ou parcourez les autres messages dans \" + d.groupLink }) + \"\\n  \", other: \"\" }) + \"\\n\",\n      \"user.messages.read_more_personal_pm_MF\": (d) => select(d.HAS_UNREAD_AND_NEW, { true: \"\\n    \" + plural(d.UNREAD, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" message non lu</a>\", other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" messages non lus</a>\" }) + \"\\n    \" + plural(d.NEW, 0, fr, { \"0\": \"\", one: \" et <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveau message</a> restant, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\", other: \" et <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveaux messages</a> restants, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\" }) + \"\\n  \", false: \"\\n    \" + plural(d.UNREAD, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" message non lu</a> restant, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\", other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"fr\", d.UNREAD, 0) + \" messages non lus</a> restants, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\" }) + \"\\n    \" + plural(d.NEW, 0, fr, { \"0\": \"\", one: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveau message</a> restant, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\", other: \"Il y a <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"fr\", d.NEW, 0) + \" nouveaux messages</a> restants, ou parcourez les autres <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">messages privés</a>\" }) + \"\\n  \", other: \"\" }) + \"\\n\",\n      \"user.invited.invite.link_validity_MF\": (d) => \"Le lien est valable pour jusqu'à \" + plural(d.user_count, 0, fr, { one: number(\"fr\", d.user_count, 0) + \" utilisateur\", other: number(\"fr\", d.user_count, 0) + \" utilisateurs\" }) + \" et expire dans \" + plural(d.duration_days, 0, fr, { one: number(\"fr\", d.duration_days, 0) + \" jour\", other: number(\"fr\", d.duration_days, 0) + \" jours\" }) + \".\\n\",\n      \"logs_error_rate_notice.reached_hour_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, fr, { one: number(\"fr\", d.rate, 0) + \" erreur/heure\", other: number(\"fr\", d.rate, 0) + \" erreurs/heure\" }) + \"</a> a atteint la limite fixée du site de \" + plural(d.limit, 0, fr, { one: number(\"fr\", d.limit, 0) + \" erreur/heure\", other: number(\"fr\", d.limit, 0) + \" erreurs/heure\" }) + \".\\n\",\n      \"logs_error_rate_notice.reached_minute_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, fr, { one: number(\"fr\", d.rate, 0) + \" erreur/minute\", other: number(\"fr\", d.rate, 0) + \" erreurs/minute\" }) + \"</a> a atteint la limite fixée du site de \" + plural(d.limit, 0, fr, { one: number(\"fr\", d.limit, 0) + \" erreur/minute\", other: number(\"fr\", d.limit, 0) + \" erreurs/minute\" }) + \".\\n\",\n      \"logs_error_rate_notice.exceeded_hour_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, fr, { one: number(\"fr\", d.rate, 0) + \" erreur/heure\", other: number(\"fr\", d.rate, 0) + \" erreurs/heure\" }) + \"</a> a dépassé la limite fixée du site de \" + plural(d.limit, 0, fr, { one: number(\"fr\", d.limit, 0) + \" erreur/heure\", other: number(\"fr\", d.limit, 0) + \" erreurs/heure\" }) + \".\\n\",\n      \"logs_error_rate_notice.exceeded_minute_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, fr, { one: number(\"fr\", d.rate, 0) + \" erreur/minute\", other: number(\"fr\", d.rate, 0) + \" erreurs/minute\" }) + \"</a> a dépassé la limite fixée du site de \" + plural(d.limit, 0, fr, { one: number(\"fr\", d.limit, 0) + \" erreur/minute\", other: number(\"fr\", d.limit, 0) + \" erreurs/minute\" }) + \".\\n\",\n      \"summary.description_time_MF\": (d) => \"Il y a \" + plural(d.replyCount, 0, fr, { one: \"<b>\" + number(\"fr\", d.replyCount, 0) + \"</b> réponse\", other: \"<b>\" + number(\"fr\", d.replyCount, 0) + \"</b> réponses\" }) + \" avec un temps de lecture estimé à <b>\" + plural(d.readingTime, 0, fr, { one: number(\"fr\", d.readingTime, 0) + \" minute\", other: number(\"fr\", d.readingTime, 0) + \" minutes\" }) + \"</b>.\\n\",\n      \"flagging.delete_confirm_MF\": (d) => \"Vous êtes sur le point de supprimer \" + plural(d.POSTS, 0, fr, { one: \"<b>\" + number(\"fr\", d.POSTS, 0) + \"</b> publication\", other: \"<b>\" + number(\"fr\", d.POSTS, 0) + \"</b> publication\" }) + \" et \" + plural(d.TOPICS, 0, fr, { one: \"<b>\" + number(\"fr\", d.TOPICS, 0) + \"</b> sujet\", other: \"<b>\" + number(\"fr\", d.TOPICS, 0) + \"</b> sujets\" }) + \" de cet utilisateur, supprimer son compte, bloquer les inscriptions depuis son adresse IP <b>\" + d.ip_address + \"</b> et ajouter son adresse e-mail <b>\" + d.email + \"</b> à une liste de blocage permanent. Êtes-vous sûr(e) que cet utilisateur est un spammeur ?\\n\",\n      posts_likes_MF: (d) => plural(d.count, 0, fr, { one: number(\"fr\", d.count, 0) + \" réponse,\", other: number(\"fr\", d.count, 0) + \" réponses,\" }) + select(d.ratio, { low: \" avec un taux élevé de « J'aime » par publication,\", med: \" avec un taux très élevé de « J'aime » par publication,\", high: \" avec un taux extrêmement élevé de « J'aime » par publication,\", other: \"\" }) + \" accéder à la première ou dernière publication...\\n\",\n      \"chat.mention_warning.groups.too_many_members_MF\": (d) => plural(d.groupCount, 0, fr, { \"1\": \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de @\" + d.group1 + \" dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de @\" + d.group1 + \" dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de @\" + d.group1 + \" dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de @\" + d.group1 + \" dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \", \"2\": \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de @\" + d.group1 + \" et de @\" + d.group2 + \" dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de @\" + d.group1 + \" et de @\" + d.group2 + \" dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de @\" + d.group1 + \" et de @\" + d.group2 + \" dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de @\" + d.group1 + \" et @\" + d.group2 + \" dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \", other: \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de ces \" + d.groupCount + \" groupes dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de ces \" + d.groupCount + \" groupes dépasse la <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">limite de notification</a> de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, fr, { one: \"La mention de ces \" + d.groupCount + \" groupes dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateur.\", other: \"La mention de ces \" + d.groupCount + \" groupes dépasse la limite de notification de \" + number(\"fr\", d.notificationLimit, 0) + \" utilisateurs.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \" }) + \"\\n\",\n      \"chat.create_channel.auto_join_users.warning_multiple_groups_MF\": (d) => plural(d.groupCount, 0, fr, { one: \"\\n          \" + plural(d.userCount, 0, fr, { one: \"Ajouter automatiquement \" + d.userCount + \" utilisateur de \" + d.groupName + \" et de \" + d.groupCount + \" autre groupe ?\", other: \"Ajouter automatiquement \" + d.userCount + \" utilisateurs de \" + d.groupName + \" et de \" + d.groupCount + \" autres groupes ?\" }) + \"\\n        \", other: \"\\n          \" + plural(d.userCount, 0, fr, { one: \"Ajouter automatiquement \" + d.userCount + \" utilisateur de \" + d.groupName + \" et de \" + d.groupCount + \" autre groupe ?\", other: \"Ajouter automatiquement \" + d.userCount + \" utilisateurs de \" + d.groupName + \" et de \" + d.groupCount + \" autres groupes ?\" }) + \"\\n        \" }) + \"\\n\",\n      \"admin.user.penalty_history_MF\": (d) => \"Au cours des 6 derniers mois, cet utilisateur a été <b>suspendu \" + plural(d.SUSPENDED, 0, fr, { one: number(\"fr\", d.SUSPENDED, 0) + \" fois\", other: number(\"fr\", d.SUSPENDED, 0) + \" fois\" }) + \"</b> et <b>mis en sourdine \" + plural(d.SILENCED, 0, fr, { one: number(\"fr\", d.SILENCED, 0) + \" fois\", other: number(\"fr\", d.SILENCED, 0) + \" fois\" }) + \"</b>.\",\n      \"admin.user.delete_all_posts_confirm_MF\": (d) => \"Vous êtes sur le point de supprimer \" + plural(d.POSTS, 0, fr, { one: number(\"fr\", d.POSTS, 0) + \" message\", other: number(\"fr\", d.POSTS, 0) + \" messages\" }) + \" et \" + plural(d.TOPICS, 0, fr, { one: number(\"fr\", d.TOPICS, 0) + \" sujet\", other: number(\"fr\", d.TOPICS, 0) + \" sujets\" }) + \". Voulez-vous continuer ?\\n\"\n    },\n    en: {\n      \"about.traffic_info_footer_MF\": (d) => \"In the last 6 months, this site has served content to an estimated \" + plural(d.total_visitors, 0, en, { one: number(\"en\", d.total_visitors, 0) + \" people\", other: number(\"en\", d.total_visitors, 0) + \" people\" }) + \" each month, with an estimated \" + plural(d.eu_visitors, 0, en, { one: number(\"en\", d.eu_visitors, 0) + \" people\", other: number(\"en\", d.eu_visitors, 0) + \" people\" }) + \" from the European Union.\\n\",\n      \"about.activities.visitors_MF\": (d) => plural(d.total_count, 0, en, { one: d.total_formatted_number + \" visitor\", other: d.total_formatted_number + \" visitors\" }) + \", about \" + plural(d.eu_count, 0, en, { one: d.eu_formatted_number, other: d.eu_formatted_number }) + \" from the EU\\n\",\n      \"user.messages.read_more_group_pm_MF\": (d) => select(d.HAS_UNREAD_AND_NEW, { true: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\", other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\" }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \" and <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> message remaining, or browse other messages in \" + d.groupLink, other: \" and <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> messages remaining, or browse other messages in \" + d.groupLink }) + \"\\n  \", false: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> message remaining, or browse other messages in \" + d.groupLink, other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> messages remaining, or browse other messages in \" + d.groupLink }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> message remaining, or browse other messages in \" + d.groupLink, other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/group/\" + d.groupName + \"/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> messages remaining, or browse other messages in \" + d.groupLink }) + \"\\n  \", other: \"\" }) + \"\\n\",\n      \"user.messages.read_more_personal_pm_MF\": (d) => select(d.HAS_UNREAD_AND_NEW, { true: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\", other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\" }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \" and <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> message remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\", other: \" and <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> messages remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\" }) + \"\\n  \", false: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> message remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\", other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/unread\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> messages remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\" }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> message remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\", other: \"There are <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages/new\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> messages remaining, or browse other <a href=\\\"\" + d.basePath + \"/u/\" + d.username + \"/messages\\\">personal messages</a>\" }) + \"\\n  \", other: \"\" }) + \"\\n\",\n      \"user.invited.invite.link_validity_MF\": (d) => \"Link is valid for up to \" + plural(d.user_count, 0, en, { one: number(\"en\", d.user_count, 0) + \" user\", other: number(\"en\", d.user_count, 0) + \" users\" }) + \" and expires in \" + plural(d.duration_days, 0, en, { one: number(\"en\", d.duration_days, 0) + \" day\", other: number(\"en\", d.duration_days, 0) + \" days\" }) + \".\\n\",\n      \"logs_error_rate_notice.reached_hour_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, en, { one: number(\"en\", d.rate, 0) + \" error/hour\", other: number(\"en\", d.rate, 0) + \" errors/hour\" }) + \"</a> reached site setting limit of \" + plural(d.limit, 0, en, { one: number(\"en\", d.limit, 0) + \" error/hour\", other: number(\"en\", d.limit, 0) + \" errors/hour\" }) + \".\\n\",\n      \"logs_error_rate_notice.reached_minute_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, en, { one: number(\"en\", d.rate, 0) + \" error/minute\", other: number(\"en\", d.rate, 0) + \" errors/minute\" }) + \"</a> reached site setting limit of \" + plural(d.limit, 0, en, { one: number(\"en\", d.limit, 0) + \" error/minute\", other: number(\"en\", d.limit, 0) + \" errors/minute\" }) + \".\\n\",\n      \"logs_error_rate_notice.exceeded_hour_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, en, { one: number(\"en\", d.rate, 0) + \" error/hour\", other: number(\"en\", d.rate, 0) + \" errors/hour\" }) + \"</a> exceeded site setting limit of \" + plural(d.limit, 0, en, { one: number(\"en\", d.limit, 0) + \" error/hour\", other: number(\"en\", d.limit, 0) + \" errors/hour\" }) + \".\\n\",\n      \"logs_error_rate_notice.exceeded_minute_MF\": (d) => \"<b>\" + d.relativeAge + \"</b> – <a href=\\\"\" + d.url + \"\\\" target=\\\"_blank\\\">\" + plural(d.rate, 0, en, { one: number(\"en\", d.rate, 0) + \" error/minute\", other: number(\"en\", d.rate, 0) + \" errors/minute\" }) + \"</a> exceeded site setting limit of \" + plural(d.limit, 0, en, { one: number(\"en\", d.limit, 0) + \" error/minute\", other: number(\"en\", d.limit, 0) + \" errors/minute\" }) + \".\\n\",\n      \"summary.description_time_MF\": (d) => \"There \" + plural(d.replyCount, 0, en, { one: \"is <b>\" + number(\"en\", d.replyCount, 0) + \"</b> reply\", other: \"are <b>\" + number(\"en\", d.replyCount, 0) + \"</b> replies\" }) + \" with an estimated read time of <b>\" + plural(d.readingTime, 0, en, { one: number(\"en\", d.readingTime, 0) + \" minute\", other: number(\"en\", d.readingTime, 0) + \" minutes\" }) + \"</b>.\\n\",\n      \"topic.read_more_MF\": (d) => select(d.HAS_UNREAD_AND_NEW, { true: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.unreadUrl + \"\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\", other: \"There are <a href=\\\"\" + d.unreadUrl + \"\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a>\" }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \" and <a href=\\\"\" + d.newUrl + \"\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> topic remaining,\", other: \" and <a href=\\\"\" + d.newUrl + \"\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> topics remaining,\" }) + \"\\n  \", false: \"\\n    \" + plural(d.UNREAD, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.unreadUrl + \"\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> topic remaining,\", other: \"There are <a href=\\\"\" + d.unreadUrl + \"\\\">\" + number(\"en\", d.UNREAD, 0) + \" unread</a> topics remaining,\" }) + \"\\n    \" + plural(d.NEW, 0, en, { \"0\": \"\", one: \"There is <a href=\\\"\" + d.newUrl + \"\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> topic remaining,\", other: \"There are <a href=\\\"\" + d.newUrl + \"\\\">\" + number(\"en\", d.NEW, 0) + \" new</a> topics remaining,\" }) + \"\\n  \", other: \"\" }) + \"\\n\" + select(d.HAS_CATEGORY, { true: \" or browse other topics in \" + d.categoryLink, false: \" or <a href=\\\"\" + d.basePath + \"/latest\\\">view latest topics</a>\", other: \"\" }) + \"\\n\",\n      \"flagging.delete_confirm_MF\": (d) => \"You are about to delete \" + plural(d.POSTS, 0, en, { one: \"<b>\" + number(\"en\", d.POSTS, 0) + \"</b> post\", other: \"<b>\" + number(\"en\", d.POSTS, 0) + \"</b> posts\" }) + \" and \" + plural(d.TOPICS, 0, en, { one: \"<b>\" + number(\"en\", d.TOPICS, 0) + \"</b> topic\", other: \"<b>\" + number(\"en\", d.TOPICS, 0) + \"</b> topics\" }) + \" from this user, remove their account, block signups from their IP address <b>\" + d.ip_address + \"</b>, and add their email address <b>\" + d.email + \"</b> to a permanent block list. Are you sure this user is really a spammer?\\n\",\n      posts_likes_MF: (d) => plural(d.count, 0, en, { one: number(\"en\", d.count, 0) + \" reply,\", other: number(\"en\", d.count, 0) + \" replies,\" }) + select(d.ratio, { low: \" high like to post ratio,\", med: \" very high like to post ratio,\", high: \" extremely high like to post ratio,\", other: \"\" }) + \" jump to the first or last post…\\n\",\n      \"chat.mention_warning.groups.too_many_members_MF\": (d) => plural(d.groupCount, 0, en, { \"1\": \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning @\" + d.group1 + \" exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning @\" + d.group1 + \" exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning @\" + d.group1 + \" exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning @\" + d.group1 + \" exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \", \"2\": \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning @\" + d.group1 + \" and @\" + d.group2 + \" exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning @\" + d.group1 + \" and @\" + d.group2 + \" exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning @\" + d.group1 + \" and @\" + d.group2 + \" exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning @\" + d.group1 + \" and @\" + d.group2 + \" exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \", other: \"\\n          \" + select(d.isAdmin, { true: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning these \" + d.groupCount + \" groups exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning these \" + d.groupCount + \" groups exceeds the <a href=\\\"\" + d.siteSettingUrl + \"\\\" target=\\\"_blank\\\">notification limit</a> of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", false: \"\\n              \" + plural(d.notificationLimit, 0, en, { one: \"Mentioning these \" + d.groupCount + \" groups exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" user.\", other: \"Mentioning these \" + d.groupCount + \" groups exceeds the notification limit of \" + number(\"en\", d.notificationLimit, 0) + \" users.\" }) + \"\\n            \", other: \"\" }) + \"\\n        \" }) + \"\\n\",\n      \"chat.create_channel.auto_join_users.warning_multiple_groups_MF\": (d) => plural(d.groupCount, 0, en, { one: \"\\n          \" + plural(d.userCount, 0, en, { one: \"Automatically add \" + d.userCount + \" user from \" + d.groupName + \" and \" + d.groupCount + \" other group?\", other: \"Automatically add \" + d.userCount + \" users from \" + d.groupName + \" and \" + d.groupCount + \" other group?\" }) + \"\\n        \", other: \"\\n          \" + plural(d.userCount, 0, en, { one: \"Automatically add \" + d.userCount + \" user from \" + d.groupName + \" and \" + d.groupCount + \" other groups?\", other: \"Automatically add \" + d.userCount + \" users from \" + d.groupName + \" and \" + d.groupCount + \" other groups?\" }) + \"\\n        \" }) + \"\\n\",\n      \"discourse_rewind.reports.chat_usage.message_2_MF\": (d) => \"You had \" + plural(d.dm_count, 0, en, { one: \"<strong>\" + number(\"en\", d.dm_count, 0) + \"</strong> DM conversation\", other: \"<strong>\" + number(\"en\", d.dm_count, 0) + \"</strong> DM conversations\" }) + \" with \" + plural(d.channel_count, 0, en, { one: \"<strong>\" + number(\"en\", d.channel_count, 0) + \"</strong> person or group\", other: \"<strong>\" + number(\"en\", d.channel_count, 0) + \"</strong> different people or groups\" }) + \".\\n\",\n      \"admin.user.penalty_post_delete_all_confirmation_MF\": (d) => \"<span>This will delete\\n\" + plural(d.TOPICS, 0, en, { one: number(\"en\", d.TOPICS, 0) + \" topic\", other: number(\"en\", d.TOPICS, 0) + \" topics\" }) + \" and\\n\" + plural(d.REPLIES, 0, en, { one: number(\"en\", d.REPLIES, 0) + \" reply\", other: number(\"en\", d.REPLIES, 0) + \" replies\" }) + \". <b>This cannot be undone!</b> Are you sure you would like to do this?</span>\\n\",\n      \"admin.user.penalty_history_MF\": (d) => \"In the past 6 months this user has been <b>suspended \" + plural(d.SUSPENDED, 0, en, { one: number(\"en\", d.SUSPENDED, 0) + \" time\", other: number(\"en\", d.SUSPENDED, 0) + \" times\" }) + \"</b> and <b>silenced \" + plural(d.SILENCED, 0, en, { one: number(\"en\", d.SILENCED, 0) + \" time\", other: number(\"en\", d.SILENCED, 0) + \" times\" }) + \"</b>.\",\n      \"admin.user.delete_all_posts_confirm_MF\": (d) => \"You are about to delete \" + plural(d.POSTS, 0, en, { one: number(\"en\", d.POSTS, 0) + \" post\", other: number(\"en\", d.POSTS, 0) + \" posts\" }) + \" and \" + plural(d.TOPICS, 0, en, { one: number(\"en\", d.TOPICS, 0) + \" topic\", other: number(\"en\", d.TOPICS, 0) + \" topics\" }) + \". Are you sure?\\n\"\n    }\n  }\n}\n"
