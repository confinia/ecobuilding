# Copy to deploy/secrets.env (gitignored) — generated automatically by
# deploy/deploy.sh on first deploy if missing.
GF_SECURITY_ADMIN_PASSWORD=change-me
# Passwordless Grafana via Keycloak (#372). Generate with `openssl rand -hex 24`,
# put the SAME value here and in the Keycloak `grafana` client (deploy/kc-grafana.sh
# reads it from here). Set GRAFANA_OAUTH_ENABLED=true to turn the login on;
# leave it false/empty and Grafana keeps its admin password.
GRAFANA_OAUTH_SECRET=
GRAFANA_OAUTH_ENABLED=false

# Confinia — histoire des communes (#275). Clé « partenaire », illimitée mais
# comptée : l'usage est ce qui dira si cette donnée mérite sa place dans une
# fiche. SANS elle, le bloc commune disparaît simplement — la fiche reste
# entière, et c'est voulu : elle ne doit jamais dépendre d'un tiers.
CONFINIA_API_KEY=
