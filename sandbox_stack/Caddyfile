# Sandbox edge (project ecobuilding-sandbox). One bridged caddy published on
# host 127.0.0.1:13400 (container-internal :8030); the platform edge forwards here and we
# dispatch by Host. Same compose project as the api/frontend, so we reach them
# by container DNS; Keycloak is a sibling container reached the same way.
{
	admin off
	auto_https off
	http_port 8030
	servers {
		trusted_proxies static private_ranges
	}
}

# App host: frontend + /auth (sandbox Keycloak) + /api (sandbox API).
http://sandbox.ecobuilding.confinia.io {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	# Sondes de scanners (#327) : 404 sec AU BORD, avant le front. Le repli
	# SPA leur répondait 200 avec index.html — un scanner qui lit des 200
	# insiste. Rien de légitime ne ressemble à ces chemins : extensions de
	# technologies qu'on n'exécute pas, fichiers cachés, consoles d'admin
	# d'autres logiciels. /.well-known reste ouvert (security.txt, un jour).
	@sondes {
		path *.php *.asp *.aspx *.jsp *.axd *.action *.cgi *.bak *.backup
		path /.git/* /.env* /.aws/* /.ssh/* /.vscode/* /.docker* /.DS_Store
		path /wp-login* /wp-admin* /wp-content/* /xmlrpc.php /cgi-bin/*
		path /actuator/* /telescope/* /server-status /console /console/*
		path /debug/* /ecp/* /jsonrpc /graphql /graphql/* /@vite/*
		path /secrets.json /keys.json /config.json /config /settings
		path /login.action /mcp /mcp/* /__proxy_subdomain_* /telescope
	}
	handle @sondes {
		respond 404
	}

	handle /auth/* {
		reverse_proxy sandbox-keycloak:8080
	}

	handle_path /api/* {
		reverse_proxy sandbox-api:8000
	}

	handle {
		header Cache-Control "no-cache"
		reverse_proxy sandbox-frontend:80
	}
}

# Dedicated API host: the FastAPI app at the domain root (clean API surface).
http://sandbox.api.ecobuilding.confinia.io {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	reverse_proxy sandbox-api:8000
}
