# EcoBuilding — configuration du parcours e2e inscription & paiement.
#   cp e2e/.env.example e2e/.env   puis compléter, puis ./e2e/run.sh
# e2e/.env n'est JAMAIS suivi par git (il contient un mot de passe admin).
# Fichier SOURCÉ par bash : toute valeur contenant une espace doit être entre
# guillemets, sans quoi le second mot est exécuté comme une commande.

# --- environnement visé -------------------------------------------------------
# sandbox : seul environnement où le paiement est branché (Polar sandbox).
# staging : le parcours d'inscription joue, le paiement est indisponible (503).
# production : REFUSÉ par run.sh — le scénario saisit une vraie carte.
ECO_ENV=sandbox

# Déduits de ECO_ENV ; à ne renseigner que pour viser autre chose.
#APP_URL=https://sandbox.ecobuilding.confinia.io
#API_URL=https://sandbox.api.ecobuilding.confinia.io
#KC_REALM=sandbox-ecobuilding
#KC_CONTAINER=ecobuilding-sandbox_sandbox-keycloak_1

# --- compte de test -----------------------------------------------------------
# Laisser E2E_EMAIL vide : une adresse jetable est frappée à chaque exécution.
# Une adresse FIXE ne peut être inscrite qu'une fois — le 2e passage échouerait
# sur « email already exists », ce qui n'est pas la régression qu'on cherche.
E2E_EMAIL=
E2E_PASSWORD=
E2E_ORG=E2E
E2E_FIRSTNAME=CI
E2E_LASTNAME=Selenium
E2E_ADDRESS="7 rue Pierre Corneille, Amiens"

# --- accès admin Keycloak -----------------------------------------------------
# Sert à deux choses : franchir la vérification e-mail (la boîte de réception
# est un mailbox externe réel, illisible depuis la CI — c'est la SEULE étape
# simulée du parcours) et supprimer le compte jetable en fin d'exécution.
# Sans ces valeurs, le parcours s'arrête après l'inscription et le dit.
KC_ADMIN_USER=ci-admin
KC_ADMIN_PASSWORD=
# Renseigner si Keycloak tourne sur la VM et pas sur la machine locale.
E2E_KC_SSH=ecobuilding

# --- carte de test Stripe (aucun euro réel : organisation Polar en sandbox) ----
E2E_CARD_NUMBER=4242424242424242
E2E_CARD_EXPIRY=12/34
E2E_CARD_CVC=123
E2E_CARD_NAME="CI Selenium"

# --- lecture de la plateforme de paiement -------------------------------------
# Jeton d'organisation Polar SANDBOX (polar_oat_…), en lecture pour le rapport.
# Repris tel quel de sandbox_stack/secrets.env sur la VM.
POLAR_BASE_URL=https://sandbox-api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_ORG_ID=
POLAR_PRODUCT_ID=

# --- réglages fins ------------------------------------------------------------
#PDF_WAIT_MS=25000          # génération WeasyPrint côté serveur
#PRO_WAIT_MS=65000          # cache de réconciliation Polar (60 s) + marge
#SELENIUM_IMAGE=docker.io/selenium/standalone-chromium:4.47.0
#CONTAINER_RUNTIME=/usr/bin/podman

# Sélecteurs du checkout Polar (DOM externe : ils peuvent bouger sans préavis ;
# les corriger ici évite de toucher au projet Selenium). Ne jamais cibler les id
# de cette page : React les régénère à chaque rendu.
#SEL_CO_EMAIL='css=input[name="customer_email"]'
#SEL_CO_NAME='css=input[name="customer_name"]'
#SEL_CO_SUBMIT='xpath=//button[contains(.,"Subscribe") or contains(.,"abonner") or contains(.,"Payer")]'
#SEL_STRIPE_FRAME='css=iframe[title="Secure payment input frame"]'
#SEL_CARD_NUMBER=css=#payment-numberInput
#SEL_CARD_EXPIRY=css=#payment-expiryInput
#SEL_CARD_CVC=css=#payment-cvcInput
